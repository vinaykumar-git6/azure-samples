# ⚠️ IMPORTANT: AzureAIAgentClient requires Azure AI Foundry project endpoint
# This is NOT the same as Azure OpenAI endpoint!
# 
# Azure AI Foundry endpoint format: https://<project-name>.<region>.api.azureml.ms
# Azure OpenAI endpoint format: https://<resource-name>.cognitiveservices.azure.com/
#
# Get Azure AI Foundry project endpoint from: https://ai.azure.com
# -> Select/Create Project -> Settings -> Connection String

# Azure AI Foundry Project Endpoint (required for AzureAIAgentClient)
# TODO: Replace with your actual Azure AI Foundry project endpoint
AZURE_AI_PROJECT_ENDPOINT="https://<your-project>.<region>.api.azureml.ms/api/projects/<your-project>"

# Model deployment name
AZURE_OPENAI_MODEL="gpt-4.1"

# Azure OpenAI Configuration (if you want to use OpenAIChatClient instead)
AZURE_OPENAI_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
AZURE_OPENAI_API_KEY="<YOUR-AZURE-OPENAI-API-KEY>"