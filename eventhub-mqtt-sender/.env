# Azure Event Grid MQTT Configuration

# Event Grid MQTT Hostname (get from: az eventgrid namespace show --query "topicSpacesConfiguration.hostname")
EVENTGRID_HOSTNAME=iot-mqtt-ns-0603.uaenorth-1.ts.eventgrid.azure.net

# MQTT Topic (must match topic space pattern, e.g., sensors/telemetry)
MQTT_TOPIC=sensors/telemetry

# MQTT Port (8883 for TLS)
MQTT_PORT=8883

# MQTT Client ID (must match Event Grid registered client name)
MQTT_CLIENT_ID=sensor-app-jwt

# Azure AD JWT Authentication
# Get these from Azure AD App Registration (Service Principal)
# Leave empty to use DefaultAzureCredential (az login, managed identity)
#AZURE_CLIENT_ID=<YOUR-CLIENT-ID>
#AZURE_TENANT_ID=<YOUR-TENANT-ID>
#AZURE_CLIENT_SECRET=<YOUR-CLIENT-SECRET>

AZURE_CLIENT_ID=<YOUR-CLIENT-ID>
AZURE_TENANT_ID=<YOUR-TENANT-ID>
AZURE_CLIENT_SECRET=<YOUR-CLIENT-SECRET>

