# Event Hub Configuration
EVENTHUB_NAMESPACE=your-eventhub-namespace
EVENTHUB_NAME=signin-events
CONSUMER_GROUP=$Default

# PostgreSQL Configuration
POSTGRES_HOST=your-postgres-server.postgres.database.azure.com
POSTGRES_DATABASE=signinevents
POSTGRES_USER=adminuser

# Azure Key Vault Configuration
KEYVAULT_URL=https://your-keyvault.vault.azure.net/
POSTGRES_PASSWORD_SECRET_NAME=postgres-password

# Application Configuration
BATCH_SIZE=100
MAX_WAIT_TIME=60

# Azure Identity (for local development)
# AZURE_CLIENT_ID=your-managed-identity-client-id
# AZURE_TENANT_ID=your-tenant-id
