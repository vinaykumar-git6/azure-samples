# Azure Event Grid MQTT Configuration

# Event Grid MQTT Hostname (get from: az eventgrid namespace show --query "topicSpacesConfiguration.hostname")
EVENTGRID_HOSTNAME=myeventgrid-mqtt-ns0603.uaenorth-1.ts.eventgrid.azure.net

# MQTT Topic (must match topic space pattern, e.g., sensors/telemetry)
MQTT_TOPIC=sensors/telemetry

# Azure AD Configuration
# Client ID (Application/Service Principal ID)
AZURE_CLIENT_ID=86339c66-ee25-474d-b5bb-b334aad19c32

# Tenant ID (Directory ID) - Optional
AZURE_TENANT_ID=your-tenant-id-here

# Client Secret - Optional, leave empty for DefaultAzureCredential (az login)
AZURE_CLIENT_SECRET=

# MQTT Port (8883 for TLS)
MQTT_PORT=8883

# MQTT Client ID (must match Event Grid registered client name)
MQTT_CLIENT_ID=sensor-app-001
