  },
  "components": {
    "schemas": {
      "CustomerProfileResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CustomerProfile"
          }
        }
      },
      "CustomerProfile": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Unique customer identifier.",
            "example": "CUST-2026-001234"
          },
          "cifNumber": {
            "type": "string",
            "description": "Customer Information File number used across systems.",
            "example": "CIF-7890123456"
          },
          "customerType": {
            "enum": [
              "INDIVIDUAL",
              "JOINT",
              "CORPORATE",
              "SME"
            ],
            "type": "string",
            "example": "INDIVIDUAL"
          },
          "segment": {
            "enum": [
              "MASS",
              "PREFERRED",
              "PRIORITY",
              "WEALTH",
              "PRIVATE"
            ],
            "type": "string",
            "description": "Customer segmentation tier determining service level.",
            "example": "PRIORITY"
          },
          "title": {
            "enum": [
              "Mr.",
              "Mrs.",
              "Ms.",
              "Dr.",
              "Prof.",
              "Sheikh",
              "Sheikha"
            ],
            "type": "string",
            "example": "Mr."
          },
          "firstName": {
            "type": "string",
            "example": "Vinay"
          },
          "middleName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "example": "Kumar"
          },
          "fullName": {
            "type": "string",
            "description": "Full name as per official documents.",
            "example": "Vinay Kumar"
          },
          "preferredName": {
            "type": "string",
            "description": "Name the customer prefers to be called.",
            "example": "Vinay"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "1990-05-15"
          },
          "gender": {
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER",
              "PREFER_NOT_TO_SAY"
            ],
            "type": "string",
            "example": "MALE"
          },
          "nationality": {
            "type": "string",
            "example": "Indian"
          },
          "countryOfResidence": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code.",
            "example": "AE"
          },
          "residencyStatus": {
            "enum": [
              "CITIZEN",
              "RESIDENT",
              "NON_RESIDENT"
            ],
            "type": "string",
            "example": "RESIDENT"
          },
          "maritalStatus": {
            "enum": [
              "SINGLE",
              "MARRIED",
              "DIVORCED",
              "WIDOWED"
            ],
            "type": "string",
            "example": "MARRIED"
          },
          "identificationDocuments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IdentificationDocument"
            }
          },
          "contactInformation": {
            "$ref": "#/components/schemas/ContactInfo"
          },
          "employment": {
            "$ref": "#/components/schemas/EmploymentInfo"
          },
          "primaryAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "accountOfficer": {
            "$ref": "#/components/schemas/AccountOfficer"
          },
          "onboardingDate": {
            "type": "string",
            "format": "date"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time"
          },
          "kycStatus": {
            "enum": [
              "PENDING",
              "VERIFIED",
              "EXPIRED",
              "REJECTED"
            ],
            "type": "string"
          },
          "kycExpiryDate": {
            "type": "string",
            "format": "date"
          },
          "fatcaStatus": {
            "enum": [
              "COMPLIANT",
              "NON_COMPLIANT",
              "PENDING"
            ],
            "type": "string"
          },
          "crsStatus": {
            "enum": [
              "COMPLIANT",
              "NON_COMPLIANT",
              "PENDING"
            ],
            "type": "string"
          }
        }
      },
      "IdentificationDocument": {
        "type": "object",
        "properties": {
          "documentType": {
            "enum": [
              "EMIRATES_ID",
              "PASSPORT",
              "DRIVING_LICENSE",
              "NATIONAL_ID"
            ],
            "type": "string"
          },
          "documentNumber": {
            "type": "string",
            "description": "Partially masked document number."
          },
          "issueDate": {
            "type": "string",
            "format": "date"
          },
          "expiryDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "VALID",
              "EXPIRED",
              "PENDING_RENEWAL"
            ],
            "type": "string"
          },
          "nationality": {
            "type": "string",
            "description": "Only applicable for passport."
          }
        }
      },
      "ContactInfo": {
        "type": "object",
        "properties": {
          "primaryMobile": {
            "type": "string",
            "description": "Primary mobile number (partially masked)."
          },
          "secondaryMobile": {
            "type": "string",
            "nullable": true
          },
          "primaryEmail": {
            "type": "string",
            "description": "Primary email address (partially masked)."
          },
          "workEmail": {
            "type": "string",
            "nullable": true
          },
          "homePhone": {
            "type": "string",
            "nullable": true
          },
          "workPhone": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EmploymentInfo": {
        "type": "object",
        "properties": {
          "employerName": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "employmentType": {
            "enum": [
              "SALARIED",
              "SELF_EMPLOYED",
              "BUSINESS_OWNER",
              "RETIRED",
              "STUDENT",
              "HOMEMAKER"
            ],
            "type": "string"
          },
          "industry": {
            "enum": [
              "TECHNOLOGY",
              "FINANCE",
              "HEALTHCARE",
              "EDUCATION",
              "GOVERNMENT",
              "OIL_GAS",
              "REAL_ESTATE",
              "RETAIL",
              "HOSPITALITY",
              "OTHER"
            ],
            "type": "string"
          },
          "annualIncome": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "format": "double"
              },
              "currency": {
                "type": "string"
              }
            }
          },
          "dateOfJoining": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "addressType": {
            "enum": [
              "HOME",
              "WORK",
              "MAILING"
            ],
            "type": "string"
          },
          "addressLine1": {
            "maxLength": 100,
            "type": "string"
          },
          "addressLine2": {
            "maxLength": 100,
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 code."
          },
          "postalCode": {
            "type": "string"
          },
          "poBox": {
            "type": "string"
          }
        }
      },
      "AccountOfficer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "preferredName": {
            "type": "string"
          },
          "maritalStatus": {
            "enum": [
              "SINGLE",
              "MARRIED",
              "DIVORCED",
              "WIDOWED"
            ],
            "type": "string"
          },
          "contactInformation": {
            "type": "object",
            "properties": {
              "primaryMobile": {
                "type": "string"
              },
              "secondaryMobile": {
                "type": "string"
              },
              "primaryEmail": {
                "type": "string",
                "format": "email"
              },
              "workEmail": {
                "type": "string",
                "format": "email"
              }
            }
          },
          "employment": {
            "type": "object",
            "properties": {
              "employerName": {
                "type": "string"
              },
              "designation": {
                "type": "string"
              },
              "employmentType": {
                "type": "string"
              },
              "annualIncome": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "format": "double"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "AddAddressRequest": {
        "required": [
          "addressType",
          "addressLine1",
          "city",
          "country"
        ],
        "type": "object",
        "properties": {
          "addressType": {
            "enum": [
              "HOME",
              "WORK",
              "MAILING"
            ],
            "type": "string"
          },
          "isPrimary": {
            "type": "boolean",
            "default": false
          },
          "addressLine1": {
            "maxLength": 100,
            "type": "string"
          },
          "addressLine2": {
            "maxLength": 100,
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "poBox": {
            "type": "string"
          }
        }
      },
      "UpdatePreferencesRequest": {
        "type": "object",
        "properties": {
          "communication": {
            "type": "object",
            "properties": {
              "preferredLanguage": {
                "type": "string"
              },
              "preferredChannel": {
                "enum": [
                  "SMS",
                  "EMAIL",
                  "PUSH_NOTIFICATION",
                  "WHATSAPP"
                ],
                "type": "string"
