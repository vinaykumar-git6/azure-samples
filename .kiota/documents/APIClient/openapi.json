{
  "openapi": "3.0.1",
  "info": {
    "title": "Client Profile API",
    "description": "## Overview\nThe **Client Profile API** provides customer profile management including personal details,\ncontact information, address management, preferences, and relationship summary.\n\n## Data Privacy\n- All PII fields are subject to data masking in non-production environments\n- Emirates ID and passport numbers are partially masked in responses\n- Customer consent is required for data sharing with third parties\n",
    "contact": {
      "name": "Banking API Support",
      "email": "api-support@bank.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://apim-dev-0603.azure-api.net/banking/clients"
    }
  ],
  "paths": {
    "/customers/me": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Get customer profile",
        "description": "Retrieves the complete profile of the authenticated customer including personal details,\ncontact information, identification documents, and account officer details.\n",
        "operationId": "getCustomerProfile",
        "responses": {
          "200": {
            "description": "Customer profile retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerProfileResponse"
                },
                "example": {
                  "data": {
                    "customerId": "CUST-2026-001234",
                    "cifNumber": "CIF-7890123456",
                    "customerType": "INDIVIDUAL",
                    "segment": "PRIORITY",
                    "title": "Mr.",
                    "firstName": "Vinay",
                    "middleName": null,
                    "lastName": "Kumar",
                    "fullName": "Vinay Kumar",
                    "preferredName": "Vinay",
                    "dateOfBirth": "1990-05-15",
                    "gender": "MALE",
                    "nationality": "Indian",
                    "countryOfResidence": "AE",
                    "residencyStatus": "RESIDENT",
                    "maritalStatus": "MARRIED",
                    "identificationDocuments": [
                      {
                        "documentType": "EMIRATES_ID",
                        "documentNumber": "784-****-*****-1",
                        "issueDate": "2024-01-15",
                        "expiryDate": "2027-01-14",
                        "status": "VALID"
                      },
                      {
                        "documentType": "PASSPORT",
                        "documentNumber": "T****5678",
                        "nationality": "Indian",
                        "issueDate": "2022-03-10",
                        "expiryDate": "2032-03-09",
                        "status": "VALID"
                      }
                    ],
                    "contactInformation": {
                      "primaryMobile": "+971-50-***-4567",
                      "secondaryMobile": null,
                      "primaryEmail": "v****@gmail.com",
                      "workEmail": "v****@microsoft.com",
                      "homePhone": null,
                      "workPhone": null
                    },
                    "employment": {
                      "employerName": "Microsoft",
                      "designation": "Senior Software Engineer",
                      "employmentType": "SALARIED",
                      "industry": "TECHNOLOGY",
                      "annualIncome": {
                        "value": 300000,
                        "currency": "AED"
                      },
                      "dateOfJoining": "2023-02-01"
                    },
                    "primaryAddress": {
                      "addressType": "HOME",
                      "addressLine1": "Apartment 1205, Building A",
                      "addressLine2": "Marina Diamond Complex",
                      "city": "Dubai",
                      "state": "Dubai",
                      "country": "AE",
                      "postalCode": "00000",
                      "poBox": "12345"
                    },
                    "accountOfficer": {
                      "name": "Sarah Johnson",
                      "designation": "Relationship Manager - Priority Banking",
                      "email": "sarah.j@bank.com",
                      "phone": "+971-4-123-4567"
                    },
                    "onboardingDate": "2023-03-01",
                    "lastLoginAt": "2026-02-14T08:30:00.0000000+00:00",
                    "kycStatus": "VERIFIED",
                    "kycExpiryDate": "2027-03-01",
                    "fatcaStatus": "COMPLIANT",
                    "crsStatus": "COMPLIANT"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Profile"
        ],
        "summary": "Update customer profile",
        "description": "Updates specific fields of the customer profile. Only fields included in the request\nbody will be updated. Certain fields like nationality and date of birth require\nbranch verification and cannot be updated through the API.\n\n**Updatable fields**: contact information, preferred name, marital status, employment details.\n**Non-updatable via API**: date of birth, nationality, identification documents.\n",
        "operationId": "updateCustomerProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              },
              "example": {
                "preferredName": "Vinay",
                "contactInformation": {
                  "primaryMobile": "+971-50-123-4567",
                  "primaryEmail": "vinay.kumar@gmail.com"
                },
                "employment": {
                  "employerName": "Microsoft",
                  "designation": "Principal Software Engineer",
                  "annualIncome": {
                    "value": 360000,
                    "currency": "AED"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully.",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "customerId": "CUST-2026-001234",
                    "updatedFields": [
                      "preferredName",
                      "contactInformation.primaryMobile",
                      "contactInformation.primaryEmail",
                      "employment.designation",
                      "employment.annualIncome"
                    ],
                    "message": "Profile updated successfully.",
                    "updatedAt": "2026-02-14T02:30:00.0000000+00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request. Non-updatable field included."
          }
        }
      }
    },
    "/customers/me/addresses": {
      "get": {
        "tags": [
          "Addresses"
        ],
        "summary": "List customer addresses",
        "description": "Retrieves all registered addresses for the customer.",
        "operationId": "listAddresses",
        "responses": {
          "200": {
            "description": "Addresses retrieved.",
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "addressId": "ADDR-001",
                      "addressType": "HOME",
                      "isPrimary": true,
                      "addressLine1": "Apartment 1205, Building A",
                      "addressLine2": "Marina Diamond Complex",
                      "city": "Dubai",
                      "state": "Dubai",
                      "country": "AE",
                      "postalCode": "00000",
                      "poBox": "12345",
                      "verificationStatus": "VERIFIED",
                      "lastVerifiedDate": "2025-03-01"
                    },
                    {
                      "addressId": "ADDR-002",
                      "addressType": "WORK",
                      "isPrimary": false,
                      "addressLine1": "Microsoft Office, Floor 15",
                      "addressLine2": "Media One Tower, Dubai Media City",
                      "city": "Dubai",
                      "state": "Dubai",
                      "country": "AE",
                      "postalCode": "00000",
                      "poBox": "502200",
                      "verificationStatus": "VERIFIED",
                      "lastVerifiedDate": "2025-03-01"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Addresses"
        ],
        "summary": "Add a new address",
        "description": "Adds a new address to the customer profile. Address verification may be required.",
        "operationId": "addAddress",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAddressRequest"
              },
              "example": {
                "addressType": "MAILING",
                "addressLine1": "PO Box 67890",
                "city": "Abu Dhabi",
                "state": "Abu Dhabi",
                "country": "AE",
                "poBox": "67890"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Address added successfully.",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "addressId": "ADDR-003",
                    "addressType": "MAILING",
                    "verificationStatus": "PENDING",
                    "message": "Address added. Verification may be required.",
                    "createdAt": "2026-02-14T03:00:00.0000000+00:00"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/me/preferences": {
      "get": {
        "tags": [
          "Preferences"
        ],
        "summary": "Get customer preferences",
        "description": "Retrieves communication, notification, and service preferences.",
        "operationId": "getPreferences",
        "responses": {
          "200": {
            "description": "Preferences retrieved.",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "customerId": "CUST-2026-001234",
                    "communication": {
                      "preferredLanguage": "en",
                      "preferredChannel": "PUSH_NOTIFICATION",
                      "smsEnabled": true,
                      "emailEnabled": true,
                      "pushEnabled": true,
                      "whatsappEnabled": false
                    },
                    "notifications": {
                      "transactionAlerts": true,
                      "transactionAlertThreshold": {
                        "value": 100,
                        "currency": "AED"
                      },
                      "balanceAlerts": true,
                      "lowBalanceThreshold": {
                        "value": 1000,
                        "currency": "AED"
                      },
                      "loginAlerts": true,
                      "promotionalOffers": false,
                      "productUpdates": true,
                      "emiReminders": true,
                      "emiReminderDaysBefore": 3,
                      "cardExpiryReminder": true
                    },
                    "services": {
                      "estatements": true,
                      "paperStatements": false,
                      "autoPayCreditCard": true,
                      "autoPayCreditCardType": "MINIMUM_DUE",
                      "biometricLogin": true,
                      "twoFactorAuth": true
                    },
                    "privacy": {
                      "dataAnalyticsConsent": true,
                      "marketingConsent": false,
                      "thirdPartyDataSharing": false,
                      "consentLastUpdated": "2025-12-01T10:00:00.0000000+00:00"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Preferences"
        ],
        "summary": "Update customer preferences",
        "description": "Updates communication, notification, or service preferences.",
        "operationId": "updatePreferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesRequest"
              },
              "example": {
                "communication": {
                  "whatsappEnabled": true
                },
                "notifications": {
                  "transactionAlertThreshold": {
                    "value": 500,
                    "currency": "AED"
                  },
                  "promotionalOffers": false
                },
                "privacy": {
                  "marketingConsent": false
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferences updated.",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "message": "Preferences updated successfully.",
                    "updatedAt": "2026-02-14T03:30:00.0000000+00:00"
                  }
                }
              }
            }
          }
        }
      }
    },
