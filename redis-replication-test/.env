# Primary Redis Cache (Write)
PRIMARY_REDIS_NAME=redis01-0603
PRIMARY_REDIS_HOST=redis01-0603.uksouth.redis.azure.net
PRIMARY_REDIS_PORT=10000

# Secondary Redis Cache (Read - Geo-replica)
SECONDARY_REDIS_NAME=redis02-0603
SECONDARY_REDIS_HOST=redis02-0603.ukwest.redis.azure.net
SECONDARY_REDIS_PORT=10000

# Test Configuration
NUM_TEST_KEYS=100
RETRY_DELAY_SECONDS=0

# Authentication: Uses Azure CLI credentials (az login)
# Make sure you're logged in: az login
# Required RBAC Role: "Redis Cache Contributor" on both caches
