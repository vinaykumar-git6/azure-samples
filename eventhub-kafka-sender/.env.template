# Azure Event Hubs Kafka Configuration

# Event Hub Namespace (without .servicebus.windows.net)
EVENTHUB_NAMESPACE=MyEventHubNamespace0603.servicebus.windows.net

# Event Hub Name (Kafka topic name)
EVENTHUB_NAME=MyMQTTEventHub0603

# Azure AD Configuration
# Client ID (Application/Service Principal ID)
AZURE_CLIENT_ID=<YOUR-CLIENT-ID>
AZURE_TENANT_ID=<YOUR-TENANT-ID>
AZURE_CLIENT_SECRET=<YOUR-CLIENT-SECRET>

# Consumer Group - Optional, default is $Default
CONSUMER_GROUP=$Default
